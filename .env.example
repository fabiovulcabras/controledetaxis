# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp — "simulado" só grava as mensagens no banco (os avisos saem pelos botões de WhatsApp); "meta" envia pela Cloud API; "evolution" pela Evolution API.
WHATSAPP_MODO=simulado
WHATSAPP_TOKEN=token-permanente-da-meta
WHATSAPP_PHONE_NUMBER_ID=id-do-numero-remetente
WHATSAPP_APP_SECRET=app-secret-do-app-na-meta
WHATSAPP_VERIFY_TOKEN=frase-longa-aleatoria-para-verificar-o-webhook
WHATSAPP_GRAPH_VERSION=v23.0

# Endereço público do painel (usado nos links das mensagens)
NEXT_PUBLIC_APP_URL=https://seu-app.vercel.app

# Protege /api/cron/prazos
CRON_SECRET=gere-um-segredo-longo-e-aleatorio

# E-mail ao planejamento (opcional, https://resend.com — plano gratuito). Destinatários no parâmetro planejamento_emails.
RESEND_API_KEY=
EMAIL_REMETENTE=Controle de Taxis <onboarding@resend.dev>

# Evolution API (WHATSAPP_MODO=evolution). Webhook: https://SEU-APP/api/evolution/webhook?token=<EVOLUTION_WEBHOOK_TOKEN>
EVOLUTION_URL=https://evolution.seudominio.com
EVOLUTION_API_KEY=apikey-da-instancia
EVOLUTION_INSTANCIA=taxis
EVOLUTION_WEBHOOK_TOKEN=frase-longa-aleatoria

# Upstash QStash (prazo de resposta do fornecedor). Precisa de NEXT_PUBLIC_APP_URL.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# QSTASH_URL=https://qstash.upstash.io
